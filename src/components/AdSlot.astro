---
/**
 * 광고 자리. 검수·공개된 문항 페이지의 풀이 아래 한 곳에서만 렌더링한다.
 * 검색, 준비 중, 오류, 수정 중, 미리보기 화면에는 넣지 않는다.
 * 광고 사업자의 콘텐츠·배치·개인정보 조건을 확인한 뒤 환경변수를 채워 활성화한다.
 */
import { PREVIEW } from '../lib/problems';

interface Props {
  published: boolean;
}
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const slot = import.meta.env.PUBLIC_ADSENSE_SLOT;
const enabled = Astro.props.published && !PREVIEW && client && slot;
---
{enabled && (
  <aside class="ad-slot" aria-label="광고">
    <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${client}`} crossorigin="anonymous"></script>
    <ins class="adsbygoogle" style="display:block" data-ad-client={client} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
