---
import Base from '../layouts/Base.astro';
import { allProblems, isListed, toIndexEntry } from '../lib/problems';
import { EXAMS } from '../lib/exams';

const index = (await allProblems()).filter(isListed).map(toIndexEntry);
const exams = EXAMS.map((e) => ({ year: e.year, kind: e.kind, count: e.count, paperUrl: e.paperUrl ?? null }));
---
<Base title="문항 검색" noindex>
  <h1>문항 검색</h1>
  <form action="/search/" method="get" class="search" style="margin-bottom:16px">
    <input id="q" name="q" type="search" placeholder="예: 2027 수능 22번" aria-label="문항 검색" />
    <button class="primary" type="submit">찾기</button>
  </form>
  <div id="out" aria-live="polite"></div>
  <script type="application/json" id="search-data" set:html={JSON.stringify({ index, exams })} />
</Base>

<script>
  import { search, type IndexEntry } from '../lib/query';
  import { KIND_LABEL, type ExamKind } from '../lib/exams';
  import { track } from '../lib/track';

  type ExamInfo = { year: number; kind: ExamKind; count: number; paperUrl: string | null };
  const { index, exams } = JSON.parse(document.getElementById('search-data')!.textContent!) as {
    index: IndexEntry[];
    exams: ExamInfo[];
  };
  const q = new URLSearchParams(location.search).get('q') ?? '';
  const input = document.getElementById('q') as HTMLInputElement;
  const out = document.getElementById('out')!;
  input.value = q;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  if (q.trim()) {
    const r = search(q, index);
    track('search', { results: r.results.length });

    if (r.specific && r.results.length === 1) {
      // 문항 하나를 정확히 가리키면 바로 이동한다.
      location.replace(r.results[0].url);
    } else if (r.results.length > 0) {
      out.innerHTML = `<p class="muted small">${r.results.length}개 문항</p><ul class="stack" style="list-style:none;padding:0">${r.results
        .map((e) => `<li class="card"><a href="${esc(e.url)}">${esc(e.title)}</a><div class="small muted">${esc(e.concepts.join(' · '))}</div></li>`)
        .join('')}</ul>`;
    } else if (r.specific) {
      // 아직 풀이가 없는 문항: 준비 중 안내와 공식 문제지 링크
      const exam = exams.find((e) => e.year === r.parsed.year && (!r.parsed.kind || e.kind === r.parsed.kind));
      const label = `${r.parsed.year}학년도 ${KIND_LABEL[r.parsed.kind ?? 'suneung']} 수학 ${r.parsed.number}번`;
      out.innerHTML = exam
        ? `<div class="card"><p><strong>${esc(label)}</strong> 풀이는 준비 중입니다.</p>${
            exam.paperUrl ? `<a class="btn" href="${esc(exam.paperUrl)}" target="_blank" rel="noopener">공식 문제지 ↗</a>` : ''
          }</div>`
        : `<p>${esc(label)}는 아직 지원하지 않는 시험입니다.</p>`;
    } else {
      out.innerHTML = `<p>검색 결과가 없습니다. <span class="muted">‘2027 수능 22번’처럼 학년도와 번호로 찾아보세요.</span></p>`;
    }
  }
</script>
