---
import Base from '../../../../layouts/Base.astro';
import { allProblems, inExam, isListed, urlOf } from '../../../../lib/problems';
import { EXAMS, examTitle, type Exam } from '../../../../lib/exams';

export function getStaticPaths() {
  return EXAMS.map((exam) => ({
    params: { kind: exam.kind, year: String(exam.year), subject: exam.subject },
    props: { exam },
  }));
}

const { exam } = Astro.props as { exam: Exam };
const listed = inExam((await allProblems()).filter(isListed), exam);
const byNumber = new Map(listed.map((p) => [p.data.number, p]));
const publishedCount = listed.filter((p) => p.data.status === 'published').length;
const title = examTitle(exam);
---
<Base title={`${title} 공통 풀이`} description={`${title} 공통 1~${exam.count}번 힌트와 단계별 풀이`} noindex={publishedCount === 0}>
  <nav class="crumbs"><a href="/">시험 목록</a></nav>
  <h1>{title} 공통</h1>
  <p class="muted small">
    풀이 공개 {publishedCount}/{exam.count}문항
    {exam.paperUrl && <> · <a href={exam.paperUrl} target="_blank" rel="noopener">공식 문제지 ↗</a></>}
  </p>
  <ul class="grid">
    {Array.from({ length: exam.count }, (_, i) => i + 1).map((n) => {
      const p = byNumber.get(n);
      return (
        <li>
          {p ? (
            <a href={urlOf(p)} class={p.data.status === 'draft' ? 'draft' : undefined} title={p.data.concepts.map((c) => c.label).join(', ')}>{n}</a>
          ) : (
            <span title="준비 중">{n}</span>
          )}
        </li>
      );
    })}
  </ul>
  <p class="small muted">점선 번호는 풀이를 준비하고 있는 문항입니다.</p>
</Base>
