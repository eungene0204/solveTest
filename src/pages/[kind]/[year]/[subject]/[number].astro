---
import Base from '../../../../layouts/Base.astro';
import ReportForm from '../../../../components/ReportForm.astro';
import AdSlot from '../../../../components/AdSlot.astro';
import { allProblems, hasPage, inExam, isListed, titleOf, urlOf, PREVIEW, type Problem } from '../../../../lib/problems';
import { examPath, examTitle, findExam, KIND_LABEL, PART_LABEL } from '../../../../lib/exams';
import { publishBlockers } from '../../../../lib/schema';
import { renderInline, renderMarkdown } from '../../../../lib/markdown';

// 문제 그림: src/figures/<이름>.svg 를 그대로 넣는다 (currentColor라 다크 모드에서도 보인다).
const figures = import.meta.glob<string>('../../../../figures/*.svg', { query: '?raw', import: 'default', eager: true });
const figureSvg = (name: string) => {
  const hit = Object.entries(figures).find(([path]) => path.endsWith(`/${name}.svg`));
  if (!hit) throw new Error(`src/figures/${name}.svg 없음`);
  return hit[1];
};
const CIRCLED = ['①', '②', '③', '④', '⑤'];
/** "(가) 내용" → 라벨과 내용으로 나눈다. */
const splitCondition = (src: string) => {
  const m = src.match(/^\s*(\([^)]+\))\s*([\s\S]*)$/);
  return m ? { label: m[1], body: m[2] } : { label: '', body: src };
};

export async function getStaticPaths() {
  const list = await allProblems();
  return list.filter(hasPage).map((problem) => ({
    params: {
      kind: problem.data.exam.kind,
      year: String(problem.data.exam.year),
      subject: problem.data.exam.subject,
      number: String(problem.data.number),
    },
    props: { problem },
  }));
}

const { problem } = Astro.props as { problem: Problem };
const d = problem.data;
const exam = findExam(d.exam)!;
const title = titleOf(problem);
const withdrawn = d.status === 'withdrawn';
const published = d.status === 'published';

const list = (await allProblems()).filter(isListed);
const siblings = inExam(list, exam).sort((a, b) => a.data.number - b.data.number);
const prev = siblings.filter((p) => p.data.number < d.number).at(-1);
const next = siblings.find((p) => p.data.number > d.number);
const related = d.related.map((id) => list.find((p) => p.id === id)).filter((p): p is Problem => !!p);

const blockers = PREVIEW && !published ? publishBlockers(d) : [];
const paperTypeLabel = d.paperType === 'odd' ? '홀수형' : '짝수형';
const otherPaperLabel = d.paperType === 'odd' ? '짝수형' : '홀수형';
const formatLabel = d.format === 'choice' ? '5지선다형' : '단답형';
const lastReviewed = d.reviews.map((r) => r.date).sort((a, b) => +b - +a)[0];
const fmt = (x: Date) => x.toISOString().slice(0, 10);
const paperHref = exam.paperUrl && d.paperPage ? `${exam.paperUrl}#page=${d.paperPage}` : exam.paperUrl;
const pr = d.problem;
const description = `${title} 힌트와 단계별 풀이. 첫 식을 세우는 근거와 자주 틀리는 지점을 함께 정리했습니다.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: `${title} 풀이`,
  inLanguage: 'ko',
  educationalLevel: '고등학교 3학년',
  learningResourceType: '해설',
  about: d.concepts.map((c) => c.label),
  dateModified: lastReviewed ? fmt(lastReviewed) : undefined,
};
---
<Base title={`${title} 풀이`} description={description} noindex={!published}>
  {published && <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />}

  {blockers.length > 0 && (
    <details class="banner">
      <summary>초안 · 공개 전 확인할 항목 {blockers.length}건</summary>
      <ul>{blockers.map((b) => <li>{b}</li>)}</ul>
    </details>
  )}

  <article data-problem-id={problem.id}>
    <nav class="crumbs" aria-label="위치">
      <a href="/">시험 목록</a> › <a href={examPath(exam)}>{examTitle(exam)}</a>
    </nav>
    <h1>{title}</h1>
    <p class="muted small" style="margin:0">
      {d.exam.year}학년도 · {KIND_LABEL[d.exam.kind]} · 수학 {PART_LABEL[d.exam.part]} · {d.number}번 · {formatLabel}
    </p>

    {pr && (
      <section class="problem" aria-label="문제">
        <div class="problem-text"><span class="problem-no">{d.number}.</span><Fragment set:html={renderMarkdown(pr.body)} /></div>
        {pr.figure && <div class="problem-figure" set:html={figureSvg(pr.figure)} />}
        {pr.conditions && (
          <div class="problem-conditions">
            {pr.conditions.map((c) => {
              const { label, body } = splitCondition(c);
              return <div class="cond"><span class="cond-label">{label}</span><div set:html={renderMarkdown(body)} /></div>;
            })}
          </div>
        )}
        {pr.after && <div class="problem-text" set:html={renderMarkdown(pr.after)} />}
        {pr.choices && (
          <ol class="choices">
            {pr.choices.map((c, i) => <li><span class="choice-no">{CIRCLED[i]}</span> <span set:html={renderInline(c)} /></li>)}
          </ol>
        )}
        <p class="problem-source">출처: 한국교육과정평가원 {d.exam.year}학년도 대학수학능력시험 수학 영역 {paperTypeLabel}</p>
      </section>
    )}

    <div class="source">
      {paperHref && (
        <a class={pr ? 'btn' : 'btn primary'} href={paperHref} target="_blank" rel="noopener">
          공식 문제지 열기{d.paperPage ? ` (${d.paperPage}쪽)` : ''} ↗
        </a>
      )}
      {exam.answerKeyUrl && <a class="btn" href={exam.answerKeyUrl} target="_blank" rel="noopener">공식 정답표 ↗</a>}
    </div>
    {!pr && <p class="small muted">문제지는 새 탭에서 열립니다. 이 화면의 읽던 위치는 그대로 유지됩니다.</p>}

    {withdrawn ? (
      <div class="card">
        <p><strong>이 풀이는 수정 중입니다.</strong></p>
        <p class="muted small">오류가 확인돼 공개를 잠시 중지했습니다. 검수한 수정본을 다시 올리겠습니다.</p>
      </div>
    ) : (
      <>
        <ul class="tags" aria-label="개념">
          {d.concepts.map((c) => <li>{c.label}</li>)}
        </ul>

        <details class="fold" data-track="hint_open">
          <summary>힌트 보기</summary>
          <div class="body" set:html={renderMarkdown(d.hint)} />
        </details>

        <details class="fold" id="solution" data-track="solution_open">
          <summary>풀이 보기</summary>
          <div class="body">
            <div class="first-idea">
              <div class="label">왜 이렇게 시작하나</div>
              <Fragment set:html={renderMarkdown(d.firstIdea)} />
            </div>
            {d.steps.length > 1 && (
              <nav class="step-nav" aria-label="단계로 이동">
                {d.steps.map((_, i) => <a href={`#step-${i + 1}`}>{i + 1}단계</a>)}
              </nav>
            )}
            <ol class="steps">
              {d.steps.map((s, i) => (
                <li class="step" id={`step-${i + 1}`}>
                  <h3 set:html={renderInline(s.title)} />
                  <Fragment set:html={renderMarkdown(s.body)} />
                  <div class="why"><strong>이렇게 하는 이유</strong> <Fragment set:html={renderMarkdown(s.why)} /></div>
                </li>
              ))}
            </ol>
          </div>
        </details>

        <details class="fold" data-track="answer_open">
          <summary>정답 보기</summary>
          <div class="body">
            <p class="answer">
              {d.format === 'choice' && d.answer.choice != null ? (
                <>{paperTypeLabel} {CIRCLED[d.answer.choice - 1]} <span set:html={renderInline(d.answer.value)} /></>
              ) : (
                <span set:html={renderInline(d.answer.value)} />
              )}
            </p>
            {d.format === 'choice' && d.answer.choiceOtherPaper != null && (
              <p class="small muted">{otherPaperLabel}은 {CIRCLED[d.answer.choiceOtherPaper - 1]}번입니다. 값으로 확인하세요.</p>
            )}
          </div>
        </details>

        <h2>자주 틀리는 지점</h2>
        <div class="pitfalls">
          <ul>{d.pitfalls.map((p) => <li set:html={renderInline(p)} />)}</ul>
        </div>

        <AdSlot published={published} />

        {related.length > 0 && (
          <>
            <h2>이어서 볼 기출</h2>
            <ul class="stack" style="list-style:none;padding:0">
              {related.map((r) => (
                <li class="card">
                  <a href={urlOf(r)}>{titleOf(r)}</a>
                  <div class="small muted">{r.data.concepts.map((c) => c.label).join(' · ')}</div>
                </li>
              ))}
            </ul>
          </>
        )}
      </>
    )}

    <nav class="pager" aria-label="앞뒤 문항">
      {prev ? <a href={urlOf(prev)}>← {prev.data.number}번</a> : <span>처음 문항</span>}
      {next ? <a class="next" href={urlOf(next)}>{next.data.number}번 →</a> : <span class="next">마지막 문항</span>}
    </nav>

    <ReportForm problemId={problem.id} />

    {(lastReviewed || d.changelog.length > 0) && (
      <details class="fold">
        <summary>검수·수정 기록</summary>
        <div class="body small">
          {lastReviewed && <p>최근 검수: {fmt(lastReviewed)}</p>}
          <ul>{d.changelog.map((c) => <li>{fmt(c.date)} · {c.note}</li>)}</ul>
        </div>
      </details>
    )}
  </article>
</Base>

<script>
  // 단계 링크로 들어오면 접힌 풀이를 연다.
  const openFor = (hash: string) => {
    if (hash.startsWith('#step-')) document.querySelector<HTMLDetailsElement>('#solution')?.setAttribute('open', '');
  };
  openFor(location.hash);
  addEventListener('hashchange', () => openFor(location.hash));
</script>
